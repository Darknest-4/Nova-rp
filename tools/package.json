{
  "name": "@nova-rp/tools",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA RP fejlesztői eszközök: környezet-ellenőrzés, függőségkezelés, validátorok",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "nova": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "vendor:install": "tsx src/cli.ts vendor:install",
    "vendor:verify": "tsx src/cli.ts vendor:verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
